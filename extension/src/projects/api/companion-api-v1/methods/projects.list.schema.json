{
  "method": "projects.list",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "No parameters.",
    "title": "NoParams",
    "type": "object"
  },
  "result": {
    "$defs": {
      "ProjectClass": {
        "oneOf": [
          {
            "const": "view",
            "description": "Read-only: the page reads, nothing more.",
            "type": "string"
          },
          {
            "const": "mine",
            "description": "Writable: the page may also write files (and use git, in later versions).",
            "type": "string"
          }
        ]
      },
      "ProjectRunState": {
        "oneOf": [
          {
            "enum": [
              "open",
              "error"
            ],
            "type": "string"
          },
          {
            "const": "missing",
            "description": "The folder is gone or moved.",
            "type": "string"
          }
        ]
      },
      "ProjectSummary": {
        "additionalProperties": false,
        "description": "One entry of `projects.list`.",
        "properties": {
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "class": {
            "$ref": "#/$defs/ProjectClass"
          },
          "displayPath": {
            "description": "The root with `~/` for the home directory.",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "location": {
            "description": "The trusted folder the project lies in, with `~/` for the home directory; null outside trusted folders.",
            "type": [
              "string",
              "null"
            ]
          },
          "locationName": {
            "description": "That folder's name (`devtab trust --name`).",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The folder's name.",
            "type": "string"
          },
          "state": {
            "$ref": "#/$defs/ProjectRunState"
          },
          "via": {
            "$ref": "#/$defs/Via"
          }
        },
        "required": [
          "id",
          "name",
          "displayPath",
          "class",
          "via",
          "state"
        ],
        "type": "object"
      },
      "Via": {
        "description": "How the project got its class.",
        "oneOf": [
          {
            "const": "terminal",
            "description": "A command in the person's terminal (`devtab add`, `devtab add --write`).",
            "type": "string"
          },
          {
            "const": "dialog",
            "description": "The companion's confirmation window, after the page asked.",
            "type": "string"
          },
          {
            "const": "location",
            "description": "A trusted folder (`devtab trust`) the project lies in or was added through; `location` names the folder\n(null when it is no longer trusted).",
            "type": "string"
          },
          {
            "const": "person",
            "description": "The person made it read-only (`devtab read-only`, `project.setView`); a trusted folder does not make it\nwritable again.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "$ref": "#/$defs/ProjectSummary"
    },
    "title": "Array_of_ProjectSummary",
    "type": "array"
  },
  "scope": "companion",
  "summary": "The added projects with their class, branch and state."
}

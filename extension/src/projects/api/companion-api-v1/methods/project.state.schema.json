{
  "method": "project.state",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Parameters naming a project.",
    "properties": {
      "project": {
        "type": "string"
      }
    },
    "required": [
      "project"
    ],
    "title": "ProjectParams",
    "type": "object"
  },
  "result": {
    "$defs": {
      "Gap": {
        "additionalProperties": false,
        "description": "A stretch of time without history.",
        "properties": {
          "from": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "to": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "ProjectClass": {
        "oneOf": [
          {
            "const": "view",
            "description": "Read-only: the page reads, nothing more.",
            "type": "string"
          },
          {
            "const": "mine",
            "description": "Writable: the page may also write files (and use git, in later versions).",
            "type": "string"
          }
        ]
      },
      "Via": {
        "description": "How the project got its class.",
        "oneOf": [
          {
            "const": "terminal",
            "description": "A command in the person's terminal (`devtab add`, `devtab add --write`).",
            "type": "string"
          },
          {
            "const": "dialog",
            "description": "The companion's confirmation window, after the page asked.",
            "type": "string"
          },
          {
            "const": "location",
            "description": "A trusted folder (`devtab trust`) the project lies in or was added through; `location` names the folder\n(null when it is no longer trusted).",
            "type": "string"
          },
          {
            "const": "person",
            "description": "The person made it read-only (`devtab read-only`, `project.setView`); a trusted folder does not make it\nwritable again.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`project.state`.",
    "properties": {
      "ahead": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "behind": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "branch": {
        "type": [
          "string",
          "null"
        ]
      },
      "class": {
        "$ref": "#/$defs/ProjectClass"
      },
      "detached": {
        "type": "boolean"
      },
      "historyGaps": {
        "items": {
          "$ref": "#/$defs/Gap"
        },
        "type": "array"
      },
      "hooks": {
        "description": "Hooks present in the repository's hook folder (`pre-commit`, `commit-msg`, …).",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "hooksPath": {
        "description": "Whether the repository sets `core.hooksPath`.",
        "type": "boolean"
      },
      "location": {
        "description": "The trusted folder the project lies in (`~/…`); null outside trusted folders.",
        "type": [
          "string",
          "null"
        ]
      },
      "locationName": {
        "description": "That folder's name.",
        "type": [
          "string",
          "null"
        ]
      },
      "upstream": {
        "type": [
          "string",
          "null"
        ]
      },
      "via": {
        "$ref": "#/$defs/Via"
      }
    },
    "required": [
      "class",
      "via",
      "ahead",
      "behind",
      "detached",
      "hooks",
      "hooksPath",
      "historyGaps"
    ],
    "title": "ProjectStateResult",
    "type": "object"
  },
  "scope": "project",
  "summary": "One project: class, branch, upstream, hooks."
}

{
  "method": "history.file",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Parameters naming a path in a project.",
    "properties": {
      "path": {
        "type": "string"
      },
      "project": {
        "type": "string"
      }
    },
    "required": [
      "project",
      "path"
    ],
    "title": "PathParams",
    "type": "object"
  },
  "result": {
    "$defs": {
      "Gap": {
        "additionalProperties": false,
        "description": "A stretch of time without history.",
        "properties": {
          "from": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "to": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "HistoryPoint": {
        "additionalProperties": false,
        "description": "One point of `history.file`.",
        "properties": {
          "label": {
            "description": "The server's `External change`, `Saved`, `Deleted`; the companion's `Before save`, `Before edit`,\n`Before restore`, `Before rollback`, `Before rename`, `Before delete`, `Before create`, `Uncommitted when\nadded`, `Uncommitted when made writable`, `Changed while away`, `Deleted while away`, `External change`; a\ncommit's summary.",
            "type": "string"
          },
          "point": {
            "description": "Opaque to the extension; pass it to `history.content`, `diff.sides` or `history.restore`.",
            "type": "string"
          },
          "size": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "source": {
            "$ref": "#/$defs/PointSource"
          },
          "timeMs": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "point",
          "label",
          "source",
          "size",
          "timeMs"
        ],
        "type": "object"
      },
      "PointSource": {
        "oneOf": [
          {
            "const": "server",
            "description": "The server's local history.",
            "type": "string"
          },
          {
            "const": "companion",
            "description": "The companion's own copies: before each write from the page, the baseline, the reconciliation after a stop,\nthe top-up beyond the server's limits.",
            "type": "string"
          },
          {
            "const": "commit",
            "description": "A commit that changed the file.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`history.file`.",
    "properties": {
      "gaps": {
        "description": "Stretches of time in which the companion did not watch the project (the history may miss changes there).",
        "items": {
          "$ref": "#/$defs/Gap"
        },
        "type": "array"
      },
      "points": {
        "description": "Newest first.",
        "items": {
          "$ref": "#/$defs/HistoryPoint"
        },
        "type": "array"
      }
    },
    "required": [
      "points",
      "gaps"
    ],
    "title": "HistoryFile",
    "type": "object"
  },
  "scope": "project",
  "summary": "The history points of one file (regular, inside the project, or gone): the server's, the companion's copies, commits; and the gaps."
}

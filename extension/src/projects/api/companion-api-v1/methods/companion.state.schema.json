{
  "method": "companion.state",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "No parameters.",
    "title": "NoParams",
    "type": "object"
  },
  "result": {
    "$defs": {
      "DeletePolicyState": {
        "description": "`companion.state.deletePolicy`.",
        "oneOf": [
          {
            "const": "trash",
            "description": "Deletions go to the person's Trash, or do not happen.",
            "type": "string"
          },
          {
            "const": "unavailable",
            "description": "The companion has no Trash: nothing is deleted from the browser (`trash-unavailable`).",
            "type": "string"
          }
        ]
      },
      "EnvState": {
        "additionalProperties": false,
        "description": "The environment captured from the person's login shell for git hooks (`devtab init`, `devtab env capture`):\nwhen, and the folders of its `PATH`. `capturedAt` is null until it is captured.",
        "properties": {
          "capturedAt": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "ServerRunState": {
        "oneOf": [
          {
            "enum": [
              "running",
              "restarting"
            ],
            "type": "string"
          },
          {
            "const": "refused",
            "description": "The server binary does not match its pin or broke an invariant; it is not run.",
            "type": "string"
          }
        ]
      },
      "ServerState": {
        "additionalProperties": false,
        "properties": {
          "state": {
            "$ref": "#/$defs/ServerRunState"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`companion.state`.",
    "properties": {
      "companion": {
        "type": "string"
      },
      "deletePolicy": {
        "$ref": "#/$defs/DeletePolicyState",
        "description": "How deletions from the browser happen: `trash` when they go to the Trash, `unavailable` while the companion\nhas no Trash (`file.delete` is then not in `welcome.methods`, and every deletion is refused with\n`trash-unavailable`, nothing deleted)."
      },
      "env": {
        "$ref": "#/$defs/EnvState"
      },
      "paused": {
        "description": "Whether writing is paused (always false: this version has no pause).",
        "type": "boolean"
      },
      "problems": {
        "description": "Problems the person should know about, as short English sentences; `devtab doctor` explains each.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "server": {
        "$ref": "#/$defs/ServerState"
      }
    },
    "required": [
      "companion",
      "server",
      "env",
      "paused",
      "problems",
      "deletePolicy"
    ],
    "title": "CompanionState",
    "type": "object"
  },
  "scope": "companion",
  "summary": "The companion's state: versions, server state, problems."
}

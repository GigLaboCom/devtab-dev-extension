{
  "method": "openFile.read",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Parameters naming an open file.",
    "properties": {
      "file": {
        "type": "string"
      }
    },
    "required": [
      "file"
    ],
    "title": "FileParams",
    "type": "object"
  },
  "result": {
    "$defs": {
      "LineEnding": {
        "enum": [
          "lf",
          "crlf",
          "mixed"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "`file.read`.",
    "properties": {
      "bom": {
        "type": "boolean"
      },
      "encoding": {
        "type": "string"
      },
      "hash": {
        "description": "SHA-256 (hex) of `text`: the version of the file that a later write is compared with\n(`git.status.diskHash` and `git.hunks.diskHash` are the same hash).",
        "type": "string"
      },
      "large": {
        "type": "boolean"
      },
      "lineEnding": {
        "$ref": "#/$defs/LineEnding"
      },
      "mtimeMs": {
        "format": "double",
        "type": "number"
      },
      "protected": {
        "description": "A file that runs code or changes what git runs: the same rules that mark a write (`protected.toml` and the\nfolder of the repository's `core.hooksPath`).",
        "type": "boolean"
      },
      "secret": {
        "type": "boolean"
      },
      "size": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "text": {
        "description": "The text with `\\n` line ends.",
        "type": "string"
      }
    },
    "required": [
      "text",
      "hash",
      "size",
      "mtimeMs",
      "encoding",
      "bom",
      "lineEnding",
      "large",
      "secret",
      "protected"
    ],
    "title": "FileText",
    "type": "object"
  },
  "scope": "file",
  "summary": "The text of an open file, as `file.read` gives a project's file; read by the companion itself."
}

{
  "name": "devtab-dev-extension",
  "version": "0.0.1",
  "description": "Workspace of the browser extension — turbo-orchestrated Manifest V3 extension (see extension/). The product name lives in extension/product.json.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "set-global-env": "bash bash-scripts/set_global_env.sh",
    "copy-env": "bash bash-scripts/copy_env.sh",
    "clean:bundle": "rm -rf dist dist-zip && turbo clean:bundle",
    "clean:turbo": "rm -rf .turbo && turbo clean:turbo",
    "base-build": "pnpm clean:bundle && turbo build",
    "build": "pnpm set-global-env && pnpm base-build",
    "base-dev": "rm -rf dist && turbo ready && turbo watch dev --ui=stream",
    "dev": "pnpm set-global-env CLI_CEB_DEV=true && pnpm base-dev",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write --cache",
    "format:check": "prettier . --check --cache",
    "validate:build": "bash scripts/validate-build.sh dist",
    "e2e:setup": "bash scripts/e2e-setup.sh",
    "test:e2e": "node scripts/e2e-check.mjs",
    "package": "bash scripts/package.sh",
    "icons": "node scripts/generate-icons.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm type-check && pnpm build && pnpm test && pnpm validate:build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@resvg/resvg-js": "2.6.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}

+/// The rows the scroll height is made of: every wrapped row and every spacer
+/// row. The visible range is clamped by the same height as the scroll offset,
+/// so it lays out the rows the scrolled viewport shows.
+fn scroll_rows(display_map: &DisplayMap) -> usize {
+    display_map.wrap_row_count() + display_map.spacer_row_count()
+}

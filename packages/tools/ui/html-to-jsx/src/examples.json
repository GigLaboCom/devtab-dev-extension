    { "input": "<script>const s = `a ${b}`; // \\ */ {} \u2028</script>" },
    { "input": "<textarea>a \"q\" 'b' \\ {c} `d` </script> \u2028\nnext</textarea>" },
    { "input": "<a href=\"x\" title=\"line\none\" data-x='{\"a\":\"b\"}'>t</a>" },
    { "input": "<p>&amp;amp; &amp;#65; &amp;#x41; &amp;nbsp; &amp;foo; &amp; x</p>" },
    { "input": "<p>\u00a0lead\u3000 and \u00a0trail\u00a0</p><p>\u3000\u2002x\u205f</p>" },
    { "input": "<div @click=\"go()\" :class=\"c\" a\"b=\"q\" {...x}=\"1\">t</div>", "allow": ["invalid-names"] },
    { "input": "<button onclick=\"}}); evil(); ({\">x</button>", "allow": ["handlers"] }
  ]

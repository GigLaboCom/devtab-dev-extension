// pubspec.yaml: dependencies: { http: ^1.2.0 }
import 'dart:io';
import 'package:http/http.dart' as http;
import 'package:http/io_client.dart';

Future<void> main() async {
  final request = http.Request('GET', Uri.parse('https://api.example.com/slow'));

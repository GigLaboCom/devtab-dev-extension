$ curl -F 'photo=@photo.png' -F n=1 https://api.example.com/form
package main

import (
	"bytes"
	"fmt"
	"io"
	"log"
	"mime/multipart"
	"net/http"
	"os"
)

func main() {
	var body bytes.Buffer
	form := multipart.NewWriter(&body)
	addFile(form, "photo", "photo.png", "photo.png")
	form.WriteField("n", "1")
	form.Close()
	req, err := http.NewRequest("POST", "https://api.example.com/form", &body)
	if err != nil {
		log.Fatal(err)
	}
	req.Header.Set("Content-Type", form.FormDataContentType())

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		log.Fatal(err)
	}
	defer resp.Body.Close()
	out, err := io.ReadAll(resp.Body)
	if err != nil {
		log.Fatal(err)
	}
	fmt.Printf("%s\\n", out)
}

func addFile(form *multipart.Writer, field, path, filename string) {
	data, err := os.ReadFile(path)
	if err != nil {
		log.Fatal(err)
	}
	part, err := form.CreateFormFile(field, filename)
	if err != nil {
		log.Fatal(err)
	}
	part.Write(data)
}
"
`;


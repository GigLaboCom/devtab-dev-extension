$ curl -k -m 2.5 --compressed https://api.example.com/slow
// npm install axios
import axios from 'axios';
import https from 'node:https';

const response = await axios({
  url: 'https://api.example.com/slow',
  signal: AbortSignal.timeout(2500),
  httpsAgent: new https.Agent({ rejectUnauthorized: false })
});
console.log(response.data);

$ curl -s https://api.example.com/users | jq .
// npm install axios
import axios from 'axios';

const response = await axios({
  url: 'https://api.example.com/users'
});
console.log(response.data);
! Only the curl command is translated; "| jq ." after it is ignored.

$ curl "https://api.example.com/users/$ID" -H "Authorization: Bearer $TOKEN"
// npm install axios
import axios from 'axios';

const response = await axios({
  url: 'https://api.example.com/users/$ID',
  headers: {
    'Authorization': 'Bearer $TOKEN'
  }
});
console.log(response.data);
! Shell variables and $(…) are not expanded; they stay in the code as written.

$ curl -H 'Authorization: Bearer t0k' -u a:b https://api.example.com/me
// npm install axios
import axios from 'axios';

const response = await axios({
  url: 'https://api.example.com/me',
  headers: {
    'Authorization': 'Bearer t0k'
  }
});
console.log(response.data);
! -u is ignored: the command also sets an Authorization header, which curl sends instead.


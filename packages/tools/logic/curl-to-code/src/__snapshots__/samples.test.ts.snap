exports[`§10 commands in every client > rust 1`] = `
"$ curl https://api.example.com/users
// Cargo.toml: reqwest = { version = "0.12", features = ["blocking"] }

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = reqwest::blocking::Client::new();
    let response = client
        .get("https://api.example.com/users")
        .send()?;
    println!("{}", response.text()?);
    Ok(())
}

$ curl -X POST https://api.example.com/items -H 'Content-Type: application/json' -d '{"name":"pen","qty":2}'
// Cargo.toml: reqwest = { version = "0.12", features = ["blocking"] }

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = reqwest::blocking::Client::new();
    let response = client
        .post("https://api.example.com/items")
        .header("Content-Type", "application/json")
        .body(r#"{"name":"pen","qty":2}"#)
        .send()?;
    println!("{}", response.text()?);
    Ok(())
}

$ curl 'https://api.example.com/items' --data 'a=1' --data 'b=2'
// Cargo.toml: reqwest = { version = "0.12", features = ["blocking"] }

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = reqwest::blocking::Client::new();
    let response = client
        .post("https://api.example.com/items")
        .header("Content-Type", "application/x-www-form-urlencoded")
        .body("a=1&b=2")
        .send()?;
    println!("{}", response.text()?);
    Ok(())
}

$ curl -G https://api.example.com/search --data-urlencode 'q=hello world&more' -d lang=en
// Cargo.toml: reqwest = { version = "0.12", features = ["blocking"] }

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let client = reqwest::blocking::Client::new();
    let response = client
        .get("https://api.example.com/search?q=hello+world%26more&lang=en")
        .send()?;
    println!("{}", response.text()?);
    Ok(())

! -H "Accept:" removes a header curl adds itself; ignored.

$ curl -I https://api.example.com/
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.example.com/")!)
request.httpMethod = "HEAD"

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))

$ curl -A 'probe' -e https://ref.example/ -b 'a=1' -b 'b=2' https://api.example.com/c
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.example.com/c")!)
request.setValue("probe", forHTTPHeaderField: "User-Agent")
request.setValue("https://ref.example/", forHTTPHeaderField: "Referer")
request.setValue("a=1;b=2", forHTTPHeaderField: "Cookie")

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))

$ curl -H 'X-A: 1' -H 'x-a: 2' https://api.example.com/r
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.example.com/r")!)
request.setValue("1, 2", forHTTPHeaderField: "X-A")

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))

$ curl "https://api.example.com/q" -H "X-Note: say \\"hi\\" \\$5" -d "v=\\\`x\\\`"
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.example.com/q")!)
request.httpMethod = "POST"
request.setValue("say \\"hi\\" $5", forHTTPHeaderField: "X-Note")
request.setValue("application/x-www-form-urlencoded", forHTTPHeaderField: "Content-Type")
request.httpBody = Data("v=\`x\`".utf8)

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))

$ curl --oauth2-bearer abc123 https://api.example.com/o
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.example.com/o")!)
request.setValue("Bearer abc123", forHTTPHeaderField: "Authorization")

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))

$ curl https://api.example.com/c2 # fetch it
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.example.com/c2")!)

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))

$ curl --frobnicate --proxy http://p:1 https://api.example.com/u
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.example.com/u")!)

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))
! Unknown option --frobnicate; ignored.
! --proxy is not translated; ignored.

$ curl -L -T upload.txt -H 'X-Name: Jörg' https://api.example.com/up/
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.example.com/up/upload.txt")!)
request.httpMethod = "PUT"
request.setValue("J\\u{C3}\\u{B6}rg", forHTTPHeaderField: "X-Name")
request.httpBody = try Data(contentsOf: URL(fileURLWithPath: "upload.txt"))

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))
! The X-Name header is written as UTF-8 bytes, as curl sends it: URLSession sends a header's characters as bytes.

$ curl -F 'photo=@photo.png' -F n=1 https://api.example.com/form
import Foundation
#if canImport(FoundationNetworking)
import FoundationNetworking
#endif

var request = URLRequest(url: URL(string: "https://api.example.com/form")!)
request.httpMethod = "POST"
let boundary = UUID().uuidString
let parts: [(String, Data)] = try [
    ("Content-Disposition: form-data; name=\\"photo\\"; filename=\\"photo.png\\"\\r\\nContent-Type: image/png", Data(contentsOf: URL(fileURLWithPath: "photo.png"))),
    ("Content-Disposition: form-data; name=\\"n\\"", Data("1".utf8)),
]
var form = Data()
for (head, content) in parts {
    form.append(Data("--\\(boundary)\\r\\n\\(head)\\r\\n\\r\\n".utf8))
    form.append(content)
    form.append(Data("\\r\\n".utf8))
}
form.append(Data("--\\(boundary)--\\r\\n".utf8))
request.setValue("multipart/form-data; boundary=\\(boundary)", forHTTPHeaderField: "Content-Type")
request.httpBody = form

let (data, _) = try await URLSession.shared.data(for: request)
print(String(decoding: data, as: UTF8.self))
"
`;

exports[`§10 commands in every client > wget 1`] = `
"$ curl https://api.example.com/users
wget --quiet --output-document=- \\
  'https://api.example.com/users'

$ curl -X POST https://api.example.com/items -H 'Content-Type: application/json' -d '{"name":"pen","qty":2}'
wget --quiet --output-document=- \\
  --method=POST \\
  --header 'Content-Type: application/json' \\
  --body-data '{"name":"pen","qty":2}' \\
  'https://api.example.com/items'

$ curl 'https://api.example.com/items' --data 'a=1' --data 'b=2'
wget --quiet --output-document=- \\
  --method=POST \\
  --header 'Content-Type: application/x-www-form-urlencoded' \\
  --body-data 'a=1&b=2' \\
  'https://api.example.com/items'

$ curl -G https://api.example.com/search --data-urlencode 'q=hello world&more' -d lang=en
wget --quiet --output-document=- \\
  'https://api.example.com/search?q=hello+world%26more&lang=en'

$ curl --data-urlencode 'a b' --data-urlencode '=c&d' --data-urlencode 'e=ü/?' https://api.example.com/f
wget --quiet --output-document=- \\
  --method=POST \\
  --header 'Content-Type: application/x-www-form-urlencoded' \\
  --body-data 'a+b&c%26d&e=%C3%BC%2F%3F' \\
  'https://api.example.com/f'

$ curl -u 'ann:pa:ss' https://api.example.com/me
wget --quiet --output-document=- \\
  --user 'ann' --password 'pa:ss' --auth-no-challenge \\
  'https://api.example.com/me'

$ curl -F name=Ann -F 'note=a b' https://api.example.com/form
wget --quiet --output-document=- \\
  --method=POST \\
  'https://api.example.com/form'
! wget cannot send a multipart form (-F); the form is left out.

$ curl --json '{"a":1}' https://api.example.com/x
wget --quiet --output-document=- \\
  --method=POST \\
  --header 'Content-Type: application/json' \\
  --header 'Accept: application/json' \\
  --body-data '{"a":1}' \\
  'https://api.example.com/x'

$ curl 'https://api.example.com/api' \\
  -H 'accept: */*' \\
  -b 'sid=abc; theme=dark' \\
  --data-raw $'{"text":"line1\\\\nline2 é it\\'s"}'
wget --quiet --output-document=- \\
  --method=POST \\
  --header 'accept: */*' \\
  --header 'Cookie: sid=abc; theme=dark' \\
  --header 'Content-Type: application/x-www-form-urlencoded' \\
  --body-data '{"text":"line1\\nline2 é it'\\''s"}' \\
  'https://api.example.com/api'

$ curl ^"https://api.example.com/api?q=1^&x=2^" ^
  -H ^"accept: application/json^" ^
  --data-raw ^"^{^\\^"a^\\^":1^}^"
wget --quiet --output-document=- \\
  --method=POST \\
  --header 'accept: application/json' \\
  --header 'Content-Type: application/x-www-form-urlencoded' \\
  --body-data '{"a":1}' \\
  'https://api.example.com/api?q=1&x=2'

$ curl -sSL -XPUT -H'X-Trace: 1' https://api.example.com/put -d 'x=1'
wget --quiet --output-document=- \\
  --method=PUT \\
  --header 'X-Trace: 1' \\
  --header 'Content-Type: application/x-www-form-urlencoded' \\
  --body-data 'x=1' \\
  'https://api.example.com/put'

$ curl -k -m 2.5 --compressed https://api.example.com/slow
wget --quiet --output-document=- \\
  --no-check-certificate \\
  --timeout=2.5 \\
  --compression=auto \\
  'https://api.example.com/slow'
! -m: wget times out each wait for the server, not the whole request.

$ curl -s https://api.example.com/users | jq .
wget --quiet --output-document=- \\
  'https://api.example.com/users'
! Only the curl command is translated; "| jq ." after it is ignored.

$ curl "https://api.example.com/users/$ID" -H "Authorization: Bearer $TOKEN"
wget --quiet --output-document=- \\
  --header 'Authorization: Bearer $TOKEN' \\
  'https://api.example.com/users/$ID'
! Shell variables and $(…) are not expanded; they stay in the code as written.

$ curl -H 'Authorization: Bearer t0k' -u a:b https://api.example.com/me
wget --quiet --output-document=- \\
  --header 'Authorization: Bearer t0k' \\
  'https://api.example.com/me'
! -u is ignored: the command also sets an Authorization header, which curl sends instead.

$ curl -X PURGE https://api.example.com/cache
wget --quiet --output-document=- \\
  --method=PURGE \\
  'https://api.example.com/cache'

$ curl api.example.com/plain
wget --quiet --output-document=- \\
  'http://api.example.com/plain'

$ curl -d @body.json https://api.example.com/upload
wget --quiet --output-document=- \\
  --method=POST \\
  --header 'Content-Type: application/x-www-form-urlencoded' \\
  --body-data "$(tr -d '\\r\\n' < 'body.json')" \\
  'https://api.example.com/upload'

$ curl -d 'name=Jörg 🙂' https://api.example.com/n
wget --quiet --output-document=- \\
  --method=POST \\
  --header 'Content-Type: application/x-www-form-urlencoded' \\
  --body-data 'name=Jörg 🙂' \\
  'https://api.example.com/n'

$ curl -H 'X-Empty;' -H 'Accept:' https://api.example.com/h
wget --quiet --output-document=- \\
  --header 'X-Empty: ' \\
  'https://api.example.com/h'
! -H "Accept:" removes a header curl adds itself; ignored.

$ curl -I https://api.example.com/
wget --quiet --output-document=- \\
  --method=HEAD \\
  'https://api.example.com/'

$ curl -A 'probe' -e https://ref.example/ -b 'a=1' -b 'b=2' https://api.example.com/c
wget --quiet --output-document=- \\
  --header 'User-Agent: probe' \\
  --header 'Referer: https://ref.example/' \\
  --header 'Cookie: a=1;b=2' \\
  'https://api.example.com/c'

$ curl -H 'X-A: 1' -H 'x-a: 2' https://api.example.com/r
wget --quiet --output-document=- \\
  --header 'X-A: 1, 2' \\
  'https://api.example.com/r'

$ curl "https://api.example.com/q" -H "X-Note: say \\"hi\\" \\$5" -d "v=\\\`x\\\`"
wget --quiet --output-document=- \\
  --method=POST \\
  --header 'X-Note: say "hi" $5' \\
  --header 'Content-Type: application/x-www-form-urlencoded' \\
  --body-data 'v=\`x\`' \\
  'https://api.example.com/q'

$ curl --oauth2-bearer abc123 https://api.example.com/o
wget --quiet --output-document=- \\
  --header 'Authorization: Bearer abc123' \\
  'https://api.example.com/o'

$ curl https://api.example.com/c2 # fetch it
wget --quiet --output-document=- \\
  'https://api.example.com/c2'

$ curl --frobnicate --proxy http://p:1 https://api.example.com/u
wget --quiet --output-document=- \\
  'https://api.example.com/u'
! Unknown option --frobnicate; ignored.
! --proxy is not translated; ignored.

$ curl -L -T upload.txt -H 'X-Name: Jörg' https://api.example.com/up/
wget --quiet --output-document=- \\
  --method=PUT \\
  --header 'X-Name: Jörg' \\
  --body-file 'upload.txt' \\
  'https://api.example.com/up/upload.txt'
! wget adds Content-Type: application/x-www-form-urlencoded to a body without one.

$ curl -F 'photo=@photo.png' -F n=1 https://api.example.com/form
wget --quiet --output-document=- \\
  --method=POST \\
  'https://api.example.com/form'
! wget cannot send a multipart form (-F); the form is left out.
"
`;

import http.client
import pathlib
import uuid

boundary = uuid.uuid4().hex
parts = [
    (b'Content-Disposition: form-data; name="photo"; filename="photo.png"\\r\\nContent-Type: image/png', pathlib.Path('photo.png').read_bytes()),
    (b'Content-Disposition: form-data; name="n"', '1'.encode()),
]
body = b''.join(
    b'--' + boundary.encode() + b'\\r\\n' + head + b'\\r\\n\\r\\n' + content + b'\\r\\n'
    for head, content in parts
)
body += b'--' + boundary.encode() + b'--\\r\\n'

headers = {
    'Content-Type': 'multipart/form-data; boundary=' + boundary,
}

conn = http.client.HTTPSConnection('api.example.com')
conn.request('POST', '/form', body=body, headers=headers)
response = conn.getresponse()
print(response.read().decode())

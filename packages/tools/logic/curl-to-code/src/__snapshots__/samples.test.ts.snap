exports[`§10 commands in every client > php 1`] = `
"$ curl https://api.example.com/users
<?php

$ch = curl_init('https://api.example.com/users');
curl_setopt_array($ch, [
    CURLOPT_RETURNTRANSFER => true,
]);
$response = curl_exec($ch);
if ($response === false) {
    throw new RuntimeException(curl_error($ch));
}
curl_close($ch);
echo $response;

$ curl -X POST https://api.example.com/items -H 'Content-Type: application/json' -d '{"name":"pen","qty":2}'
<?php

$ch = curl_init('https://api.example.com/items');
curl_setopt_array($ch, [
    CURLOPT_HTTPHEADER => [
        'Content-Type: application/json',
    ],
    CURLOPT_POSTFIELDS => '{"name":"pen","qty":2}',
    CURLOPT_RETURNTRANSFER => true,
]);
$response = curl_exec($ch);
if ($response === false) {
    throw new RuntimeException(curl_error($ch));
}
curl_close($ch);
echo $response;

$ curl 'https://api.example.com/items' --data 'a=1' --data 'b=2'
<?php

$ch = curl_init('https://api.example.com/items');
curl_setopt_array($ch, [
    CURLOPT_HTTPHEADER => [
        'Content-Type: application/x-www-form-urlencoded',
    ],
    CURLOPT_POSTFIELDS => 'a=1&b=2',
    CURLOPT_RETURNTRANSFER => true,
]);
$response = curl_exec($ch);
if ($response === false) {
    throw new RuntimeException(curl_error($ch));
}
curl_close($ch);
echo $response;

$ curl -G https://api.example.com/search --data-urlencode 'q=hello world&more' -d lang=en
<?php

$ch = curl_init('https://api.example.com/search?q=hello+world%26more&lang=en');

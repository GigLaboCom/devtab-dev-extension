exports[`§10 commands in every client > axios 1`] = `
"$ curl https://api.example.com/users
// npm install axios
import axios from 'axios';

const response = await axios({
  url: 'https://api.example.com/users'
});
console.log(response.data);

$ curl -X POST https://api.example.com/items -H 'Content-Type: application/json' -d '{"name":"pen","qty":2}'
// npm install axios
import axios from 'axios';

const response = await axios({
  method: 'POST',
  url: 'https://api.example.com/items',
  headers: {
    'Content-Type': 'application/json'
  },
  data: '{"name":"pen","qty":2}'
});
console.log(response.data);

$ curl 'https://api.example.com/items' --data 'a=1' --data 'b=2'
// npm install axios
import axios from 'axios';

const response = await axios({
  method: 'POST',
  url: 'https://api.example.com/items',
  headers: {
    'Content-Type': 'application/x-www-form-urlencoded'
  },
  data: 'a=1&b=2'
});
console.log(response.data);

$ curl -G https://api.example.com/search --data-urlencode 'q=hello world&more' -d lang=en
// npm install axios
import axios from 'axios';

const response = await axios({
  url: 'https://api.example.com/search?q=hello+world%26more&lang=en'
});
console.log(response.data);

$ curl --data-urlencode 'a b' --data-urlencode '=c&d' --data-urlencode 'e=ü/?' https://api.example.com/f
// npm install axios
import axios from 'axios';

const response = await axios({
  method: 'POST',
  url: 'https://api.example.com/f',
  headers: {
    'Content-Type': 'application/x-www-form-urlencoded'
  },
  data: 'a+b&c%26d&e=%C3%BC%2F%3F'
});
console.log(response.data);

$ curl -u 'ann:pa:ss' https://api.example.com/me
// npm install axios
import axios from 'axios';

const response = await axios({
  url: 'https://api.example.com/me',
  auth: {
    username: 'ann',
    password: 'pa:ss'
  }
});
console.log(response.data);

$ curl -F name=Ann -F 'note=a b' https://api.example.com/form
// npm install axios
import axios from 'axios';

const form = new FormData();
form.append('name', 'Ann');
form.append('note', 'a b');

const response = await axios({
  method: 'POST',
  url: 'https://api.example.com/form',
  data: form
});
console.log(response.data);

$ curl --json '{"a":1}' https://api.example.com/x
// npm install axios
import axios from 'axios';

const response = await axios({
  method: 'POST',
  url: 'https://api.example.com/x',
  headers: {
    'Content-Type': 'application/json',
    'Accept': 'application/json'
  },
  data: '{"a":1}'
});
console.log(response.data);

$ curl 'https://api.example.com/api' \\
  -H 'accept: */*' \\
  -b 'sid=abc; theme=dark' \\
  --data-raw $'{"text":"line1\\\\nline2 é it\\'s"}'
// npm install axios
import axios from 'axios';

const response = await axios({
  method: 'POST',
  url: 'https://api.example.com/api',
  headers: {
    'accept': '*/*',
    'Cookie': 'sid=abc; theme=dark',
    'Content-Type': 'application/x-www-form-urlencoded'
  },
  data: '{"text":"line1\\\\nline2 é it\\'s"}'
});
console.log(response.data);

$ curl ^"https://api.example.com/api?q=1^&x=2^" ^

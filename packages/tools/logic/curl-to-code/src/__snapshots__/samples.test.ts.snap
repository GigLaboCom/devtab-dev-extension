$response.Content
! The X-Name header: Invoke-WebRequest sends only ASCII in a header; left out.

$ curl -F 'photo=@photo.png' -F n=1 https://api.example.com/form
# PowerShell 7 or later
$params = @{
    Uri = 'https://api.example.com/form'
    Method = 'Post'
    Form = [ordered]@{
        'photo' = (Get-Item -LiteralPath 'photo.png')
        'n' = '1'
    }
}
$response = Invoke-WebRequest @params
$response.Content
"
`;


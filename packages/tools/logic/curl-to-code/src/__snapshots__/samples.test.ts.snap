exports[`§10 commands in every client > powershell 1`] = `
"$ curl https://api.example.com/users
# PowerShell 7 or later
$params = @{
    Uri = 'https://api.example.com/users'
}
$response = Invoke-WebRequest @params
$response.Content

$ curl -X POST https://api.example.com/items -H 'Content-Type: application/json' -d '{"name":"pen","qty":2}'
# PowerShell 7 or later
$params = @{
    Uri = 'https://api.example.com/items'
    Method = 'Post'
    Headers = @{
        'Content-Type' = 'application/json'
    }
    Body = '{"name":"pen","qty":2}'
    SkipHeaderValidation = $true
}
$response = Invoke-WebRequest @params
$response.Content

$ curl 'https://api.example.com/items' --data 'a=1' --data 'b=2'
# PowerShell 7 or later
$params = @{
    Uri = 'https://api.example.com/items'
    Method = 'Post'
    Headers = @{
        'Content-Type' = 'application/x-www-form-urlencoded'
    }
    Body = 'a=1&b=2'
    SkipHeaderValidation = $true
}
$response = Invoke-WebRequest @params
$response.Content

$ curl -G https://api.example.com/search --data-urlencode 'q=hello world&more' -d lang=en
# PowerShell 7 or later
$params = @{
    Uri = 'https://api.example.com/search?q=hello+world%26more&lang=en'
}
$response = Invoke-WebRequest @params
$response.Content

$ curl --data-urlencode 'a b' --data-urlencode '=c&d' --data-urlencode 'e=ü/?' https://api.example.com/f
# PowerShell 7 or later
$params = @{
    Uri = 'https://api.example.com/f'
    Method = 'Post'
    Headers = @{
        'Content-Type' = 'application/x-www-form-urlencoded'
    }
    Body = 'a+b&c%26d&e=%C3%BC%2F%3F'
    SkipHeaderValidation = $true
}
$response = Invoke-WebRequest @params
$response.Content

$ curl -u 'ann:pa:ss' https://api.example.com/me
# PowerShell 7 or later
$params = @{
    Uri = 'https://api.example.com/me'
    Headers = @{
        'Authorization' = 'Basic ' + [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes('ann:pa:ss'))
    }
    SkipHeaderValidation = $true
}
$response = Invoke-WebRequest @params
$response.Content

$ curl -F name=Ann -F 'note=a b' https://api.example.com/form
# PowerShell 7 or later
$params = @{
    Uri = 'https://api.example.com/form'
    Method = 'Post'
    Form = [ordered]@{
        'name' = 'Ann'
        'note' = 'a b'
    }
}
$response = Invoke-WebRequest @params
$response.Content

$ curl --json '{"a":1}' https://api.example.com/x
# PowerShell 7 or later
$params = @{
    Uri = 'https://api.example.com/x'
    Method = 'Post'
    Headers = @{
        'Content-Type' = 'application/json'
        'Accept' = 'application/json'
    }
    Body = '{"a":1}'
    SkipHeaderValidation = $true
}
$response = Invoke-WebRequest @params
$response.Content

$ curl 'https://api.example.com/api' \\
  -H 'accept: */*' \\
  -b 'sid=abc; theme=dark' \\
  --data-raw $'{"text":"line1\\\\nline2 é it\\'s"}'
# PowerShell 7 or later

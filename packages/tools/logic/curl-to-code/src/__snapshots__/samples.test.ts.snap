console.log(response.data);

$ curl --frobnicate --proxy http://p:1 https://api.example.com/u
// npm install axios
import axios from 'axios';

const response = await axios({
  url: 'https://api.example.com/u'
});
console.log(response.data);
! Unknown option --frobnicate; ignored.
! --proxy is not translated; ignored.

$ curl -L -T upload.txt -H 'X-Name: Jörg' https://api.example.com/up/
// npm install axios
import axios from 'axios';
import { readFile } from 'node:fs/promises';

const response = await axios({
  method: 'PUT',
  url: 'https://api.example.com/up/upload.txt',
  headers: {
    'X-Name': 'J\\xC3\\xB6rg'
  },
  data: await readFile('upload.txt')
});
console.log(response.data);
! The X-Name header is written as UTF-8 bytes, as curl sends it: Node sends a header's characters as bytes.
! axios adds Content-Type: application/x-www-form-urlencoded to a body without one.

$ curl -F 'photo=@photo.png' -F n=1 https://api.example.com/form
// npm install axios
import axios from 'axios';
import { readFile } from 'node:fs/promises';

const form = new FormData();
form.append('photo', new Blob([await readFile('photo.png')]), 'photo.png');
form.append('n', '1');

const response = await axios({
  method: 'POST',
  url: 'https://api.example.com/form',
  data: form
});
console.log(response.data);
"
`;


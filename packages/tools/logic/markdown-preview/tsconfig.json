{
  "extends": "@extension/tsconfig/app",
  "compilerOptions": {
    // A tool's logic has no DOM (D14) unless its specification needs one. This one does (markdown-preview.md §5.6, §9:
    // the allowlist builds nodes of a Document that comes in as a parameter), so the DOM library is in for its types;
    // the globals of a page (`document`, `window`) stay forbidden by the lint.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src"]
}

{
  "name": "@workspace/dna",
  "version": "0.1.0",
  "description": "The style DNA: gpui-kit's themes as shadcn/ui variables, the base layer, the shadcn style tuned to gpui-kit (style-gpui.css), the extension page frame, tokens.json and the lint that holds pages to the contract. Shared by the extension and, later, the product site; see README.md.",
  "private": true,
  "type": "module",
  "exports": {
    "./theme.css": "./theme.css",
    "./themes.css": "./themes.css",
    "./fonts.css": "./fonts.css",
    "./tailwind.css": "./tailwind.css",
    "./style-gpui.css": "./style-gpui.css",
    "./style-gpui-dialog.css": "./style-gpui-dialog.css",
    "./style-gpui-tools.css": "./style-gpui-tools.css",
    "./ui.css": "./ui.css",
    "./sections.css": "./sections.css",
    "./shell.css": "./shell.css",
    "./menu.css": "./menu.css",
    "./tokens.json": "./tokens.json",
    "./themes.index.json": "./themes.index.json",
    "./lint": "./lint/rules.ts"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "tokens": "node scripts/tokens.mjs --write",
    "sync:themes": "node scripts/sync-themes.mjs",
    "clean:turbo": "rm -rf .turbo",
    "showcase": "node showcase/build.mjs"
  },
  "dependencies": {
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@extension/tsconfig": "workspace:*",
    "@tailwindcss/node": "4.3.5",
    "@types/node": "^22.20.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
